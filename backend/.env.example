# Configurazione Server Backend (Express)
PORT=3000

# Modalità Ambiente:
# - 'development': l'esecuzione di 'npm run init-db' resetta e ripopola il DB ad ogni avvio.
# - 'production': l'esecuzione di 'npm run init-db' viene bloccata se le tabelle esistono già.
# - 'test': carica automaticamente '.env.test' per eseguire i test d'integrazione su un DB isolato.
NODE_ENV=development

# =================================================================
# CONFIGURAZIONE DATABASE
# =================================================================

# --- OPZIONE A: AIVEN CLOUD MYSQL (Default Attivo) ---
# Se si usa Aiven, non serve avere MySQL attivo sul PC locale.
DB_HOST=your_aiven_host_here
DB_PORT=your_aiven_port_here
DB_USER=your_aiven_user_here
DB_PASSWORD=your_aiven_password_here
DB_NAME=defaultdb

# Configurazione SSL (obbligatorio su Aiven: 'REQUIRED' o 'true'; impostare 'false' in locale)
DB_SSL=REQUIRED
# Percorso relativo alla root del backend (es. "./config/ca.pem") o contenuto PEM inline della CA Aiven
DB_SSL_CA="./config/ca.pem"

# Opzionale: Stringa di connessione completa (ha la precedenza sulle singole variabili DB_*)
# MYSQL_URL=mysql://your_aiven_user:your_aiven_password@your_aiven_host:your_aiven_port/defaultdb?ssl-mode=REQUIRED

# --- OPZIONE B: MYSQL LOCALE (Sviluppo Locale) ---
# Per usare il DB locale: decommentare le righe sottostanti, commentare Aiven
# e assicurarsi che il servizio MySQL locale sia in esecuzione sulla macchina.
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=your_local_password
# DB_NAME=defaultdb
# DB_SSL=false

# =================================================================
# CONFIGURAZIONE TEST D'INTEGRAZIONE (.env.test)
# =================================================================
# Per lanciare `npm test` senza sovrascrivere i dati di sviluppo, crea un file
# `.env.test` nella root del backend con le stesse credenziali ma un database dedicato:
# DB_NAME=lookbook_test
