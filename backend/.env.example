# Configurazione Server Backend (Express)
PORT=3000

# Modalità Ambiente:
# - 'development': l'esecuzione di 'npm run init-db' resetta e ripopola il DB ad ogni avvio.
# - 'production': l'esecuzione di 'npm run init-db' viene bloccata se le tabelle esistono già.
NODE_ENV=development

# =================================================================
# CONFIGURAZIONE DATABASE
# =================================================================

# --- OPZIONE A: AIVEN CLOUD MYSQL (Default Attivo) ---
# Se si usa Aiven, non serve avere MySQL attivo sul PC locale.
DB_HOST=your_aiven_host_here
DB_PORT=your_aiven_port_here
DB_USER=your_aiven_user_here
DB_PASSWORD=your_aiven_password_here
DB_NAME=defaultdb

# --- OPZIONE B: MYSQL LOCALE (Sviluppo Locale) ---
# Per usare il DB locale: decommentare le righe sottostanti, commentare Aiven
# e assicurarsi che il servizio MySQL locale sia in esecuzione sulla macchina.
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=your_local_password
# DB_NAME=defaultdb